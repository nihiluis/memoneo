# Set the HTTPS origin assigned to your sidecar by Tailscale.
APP_ORIGIN=
TAILSCALE_HOSTNAME=memoneo
# Optional for automatic initial enrollment; otherwise authorize the login link.
TAILSCALE_AUTH_KEY=
# Full URL to your external database, including host, port and TLS mode.
# Example: postgres://USER:URL_ENCODED_PASSWORD@DB_HOST:DB_PORT/DB_NAME?sslmode=disable
DATABASE_URL=
AUTH_KID=memoneo-auth
AUTH_JWT_ISSUER=memoneo-auth
AUTH_JWT_AUDIENCE=memoneo
AUTH_JWT_SIGNING_KEY=
API_IMAGE=ghcr.io/nihiluis/memoneo-api:v1.0.1
AUTH_IMAGE=ghcr.io/nihiluis/memoneo-auth:v0.1.1
WEB_IMAGE=ghcr.io/nihiluis/memoneo-web:v1.0.0
