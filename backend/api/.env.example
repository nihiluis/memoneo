# API service local environment

PORT=8073
AUTH_API_URL=http://localhost:8089
AUTH_JWT_ISSUER=memoneo-auth
AUTH_JWT_AUDIENCE=memoneo

# Either provide DATABASE_URL, or the DB_* variables below.
DATABASE_URL=postgres://memoneo:change-me@localhost:5433/memoneo?sslmode=disable

DB_HOST=localhost
DB_PORT=5433
DB_STORE=memoneo
DB_USER=memoneo
DB_PASSWORD=change-me

# Browser origins permitted to connect to the notes API (pipe-separated).
ALLOW_ORIGINS=http://localhost:8081|http://localhost:8080|https://web.memoneo2.yourdomain.com
